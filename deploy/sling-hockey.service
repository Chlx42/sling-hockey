[Unit]
Description=Sling Hockey game server (弹射冰球)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sling-hockey
Environment=PORT=3217
Environment=SLING_DATA_DIR=/opt/sling-hockey/data
ExecStart=/usr/local/bin/node server/index.mjs
EnvironmentFile=-/etc/northward-games/hockey.env
CPUQuota=100%
TasksMax=128
Restart=on-failure
RestartSec=3
MemoryMax=512M

[Install]
WantedBy=multi-user.target
